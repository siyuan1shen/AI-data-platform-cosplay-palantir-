# V3 本地开发配置。不得在仓库中保存真实密钥、密码或企业数据。
# Windows 启动器会自动设置独立于仓库的数据目录和前端构建目录。
# 只有明确需要覆盖默认值时才取消注释。
# EI_BACKEND_DATA_DIR=C:/Users/<user>/AppData/Local/EnterpriseInsight/data
# EI_BACKEND_DATABASE_URL=sqlite:///C:/Users/<user>/AppData/Local/EnterpriseInsight/data/enterprise_insight_v3.db
# EI_BACKEND_FRONTEND_DIST_DIR=C:/path/to/palantir/frontend/dist
# EI_BACKEND_AGENT_WORKER_ENABLED=true
# EI_BACKEND_AGENT_CONTEXT_MAX_CHARS=60000
# EI_BACKEND_AGENT_INITIAL_GRAPH_ENTITIES=200
# EI_BACKEND_AGENT_INITIAL_GRAPH_RELATIONS=400
# EI_BACKEND_AGENT_MODEL_MAX_RETRIES=2
# EI_BACKEND_AGENT_MODEL_RETRY_BASE_SECONDS=0.25
